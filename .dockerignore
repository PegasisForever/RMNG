# Build context excludes.
#
# NOT excluded, load-bearing:
#   - gnome-patch/      (template/Dockerfile's gnome-build stage compiles the patched shell;
#                        the root Dockerfile no longer does)
#   - template/setup/   (the template Dockerfile's provisioning phase scripts)
#   - docs/CLI.md       (include_str!'d into the server binary; see below)

# Rust build output (25G+; rebuilt in-stage with cache mounts)
target/
**/target/

# JS deps + build outputs (reinstalled/rebuilt in the bun stage)
node_modules/
**/node_modules/
frontend/build/

# Dev payload staging dir (plain clone-daemon / agent-wrapper / gnome-shell.deb for
# `cargo run` — assets.rs's dev fallback). The image build never consumes it (payloads
# are built in-stage), and staged binaries would add ~117MB to the context via COPY . .
crates/control-server/embedded-bin/

# VCS + tooling metadata
.git/
.gitignore
.dockerignore

# Docs / agent scaffolding. CLI.md is the exception: it is `include_str!`'d as the in-clone
# `rmng-cli` skill, so it MUST be in context.
docs/
!docs/CLI.md
.superpowers/
.claude/

# Repo-root scripts. Host-only convenience wrappers (publish-server.sh,
# publish-template.sh, build-macos-app.sh): run on the host, never consumed by an image
# build, so they stay out of the context. Root-anchored (leading `/`) so it excludes this
# directory only, never a `scripts/` dir at any deeper level.
/scripts/

# Editor/OS cruft
*.tmp.*
*.swp
.DS_Store
